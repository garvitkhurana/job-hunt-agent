# === Personalized content generation ===
# Both NVIDIA and OpenRouter are free-tier friendly. Set BOTH for more quota —
# the agent tries NVIDIA first, then OpenRouter, then OpenAI if set.

# 1) NVIDIA NIM — https://build.nvidia.com  (key: nvapi-...)
#    Direct GPU-hosted models. Free credits (~40 req/min). Model IDs from their catalog.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 2) OpenRouter — https://openrouter.ai/keys  (key: sk-or-...)
#    Aggregator over many providers incl. free NVIDIA/Llama/etc. Separate quota pool.
#    Free models end with :free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_SEC=60
# Prefer 8B on NIM for speed; Nemotron-49B is higher quality but slower / rate-limit prone.

# 3) Optional paid OpenAI fallback
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# === Scheduling link (goes into every email + pitch) ===
SCHEDULING_LINK=

# === Email sending — pick ONE (both free options) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=garvit.khurana@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=Garvit Khurana <garvit.khurana@gmail.com>

# Inbox scan (same app password as SMTP) — hunt inbox
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=  # defaults to SMTP_USER
# IMAP_PASS=  # defaults to SMTP_PASS

RESEND_API_KEY=

RESUME_PDF=/Users/garvitkhurana/Documents/Garvit Docs/Resumes/GarvitKhurana_Resume.pdf

APOLLO_API_KEY=
HUNTER_API_KEY=

DAILY_APP_TARGET=30
DAILY_OUTREACH_TARGET=40
MIN_MATCH_SCORE=0.62
